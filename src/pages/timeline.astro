---
// Timeline page
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollTimeline from '../components/timeline/ScrollTimeline.astro';
import { getCollection } from 'astro:content';

const allTimelineEntries = await getCollection('timeline');

// Sort by start date (most recent first)
const sortedEntries = allTimelineEntries.sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime();
});
---

<BaseLayout
  title="Timeline"
  description="Professional timeline including roles, responsibilities, and key achievements in healthcare interoperability"
>
  <div class="timeline-page section">
    <div class="container">
      <header class="timeline-page__header">
        <p class="timeline-page__eyebrow">Career timeline</p>
        <h1 id="timeline-heading">Professional Timeline</h1>
        <p class="lead">
          My journey in healthcare interoperability, technical architecture,
          and software development
        </p>
      </header>

      <ScrollTimeline entries={sortedEntries} />
    </div>
  </div>
</BaseLayout>
