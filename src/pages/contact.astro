---
// Contact page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact" 
  description="Get in touch to discuss healthcare interoperability, FHIR implementations, or technical architecture"
>
  <div class="section">
    <div class="container">
      <div class="content-wrapper">
        <h1>Get in Touch</h1>
        
        <p class="lead">
          I'm interested in healthcare interoperability challenges, standards 
          implementation, and how technology can improve healthcare delivery.
        </p>
        
        <div class="contact-content">
          <div class="contact-section">
            <h2>Connect</h2>
            <p>
              The best way to connect with me is through GitHub or LinkedIn:
            </p>
            
            <div class="contact-links">
              <a 
                href="https://github.com/duncanfalconer" 
                class="contact-link-card card"
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="contact-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                  </svg>
                </div>
                <div>
                  <h3>GitHub</h3>
                  <p>View my projects, contributions, and code</p>
                  <span class="link-arrow">Visit GitHub →</span>
                </div>
              </a>
              
              <a 
                href="https://linkedin.com/in/duncanfalconer" 
                class="contact-link-card card"
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="contact-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                <div>
                  <h3>LinkedIn</h3>
                  <p>Professional profile and connections</p>
                  <span class="link-arrow">Visit LinkedIn →</span>
                </div>
              </a>
            </div>
          </div>
          
          <div class="contact-section">
            <h2>Topics of Interest</h2>
            <p>I'm particularly interested in discussions about:</p>
            <ul>
              <li>Healthcare interoperability challenges and solutions</li>
              <li>HL7 FHIR implementation patterns and best practices</li>
              <li>Cross-border healthcare data exchange</li>
              <li>API architecture for healthcare systems</li>
              <li>Standards-based integration approaches</li>
              <li>Developer experience in healthcare IT</li>
              <li>Technical architecture for healthcare applications</li>
            </ul>
          </div>
          
          <div class="contact-section">
            <h2>Collaboration</h2>
            <p>
              I'm open to:
            </p>
            <ul>
              <li>Technical discussions and knowledge sharing</li>
              <li>Open source healthcare interoperability projects</li>
              <li>Standards development and implementation feedback</li>
              <li>Speaking opportunities on healthcare interoperability topics</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  @import '../styles/variables';
  
  .contact-content {
    margin-top: var(--space-2xl);
  }
  
  .contact-section {
    margin-bottom: var(--space-3xl);
    
    &:last-child {
      margin-bottom: 0;
    }
    
    h2 {
      margin-bottom: var(--space-md);
    }
    
    p, ul {
      color: var(--color-text-light);
      line-height: var(--line-height-relaxed);
    }
  }
  
  .contact-links {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    
    @include media-md {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }
  
  .contact-link-card {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    
    &:hover {
      text-decoration: none;
      transform: translateY(-2px);
      
      h3 {
        color: var(--color-primary);
      }
      
      .link-arrow {
        color: var(--color-primary);
      }
    }
    
    &:focus-visible {
      @include focus-ring;
    }
    
    h3 {
      font-size: var(--font-size-lg);
      margin-bottom: var(--space-xs);
      transition: color var(--transition-fast);
    }
    
    p {
      margin: 0 0 var(--space-sm) 0;
      color: var(--color-text-light);
      font-size: var(--font-size-base);
    }
  }
  
  .contact-icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-md);
    color: var(--color-primary);
  }
  
  .link-arrow {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }
</style>
