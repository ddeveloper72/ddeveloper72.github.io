---
// Individual case study page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study }
  }));
}

type Props = {
  study: CollectionEntry<'case-studies'>;
};

const { study } = Astro.props;
const { Content } = await study.render();
---

<BaseLayout 
  title={study.data.title}
  description={study.data.description}
>
  <article class="section">
    <div class="container">
      <div class="case-study-header">
        <h1>{study.data.title}</h1>
        <p class="lead">{study.data.description}</p>
        
        <div class="case-study-meta">
          <div class="meta-card">
            <h3>Problem</h3>
            <p>{study.data.problem}</p>
          </div>
          
          <div class="meta-card">
            <h3>Context</h3>
            <p>{study.data.context}</p>
          </div>
        </div>
        
        <div class="meta-grid">
          <div class="meta-section">
            <h4>Technologies</h4>
            <div class="tags">
              {study.data.technologies.map((tech) => (
                <span class="tag tag-primary">{tech}</span>
              ))}
            </div>
          </div>
          
          {study.data.standards && study.data.standards.length > 0 && (
            <div class="meta-section">
              <h4>Standards</h4>
              <div class="tags">
                {study.data.standards.map((standard) => (
                  <span class="tag tag-accent">{standard}</span>
                ))}
              </div>
            </div>
          )}
        </div>
        
        <div class="btn-group">
          {study.data.repository && (
            <a 
              href={study.data.repository} 
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              View Repository
            </a>
          )}
          {study.data.demo && (
            <a 
              href={study.data.demo} 
              class="btn btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Live Demo
            </a>
          )}
        </div>
      </div>
      
      <div class="content-wrapper case-study-content">
        <Content />
      </div>
      
      <div style="margin-top: var(--space-3xl);">
        <a href="/case-studies" class="btn btn-outline">← Back to Case Studies</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  @import '../../styles/variables';
  
  .case-study-header {
    margin-bottom: var(--space-2xl);
    
    h1 {
      margin-bottom: var(--space-lg);
    }
    
    .lead {
      margin-bottom: var(--space-xl);
    }
  }
  
  .case-study-meta {
    display: grid;
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
    
    @include media-md {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }
  
  .meta-card {
    padding: var(--space-lg);
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-md);
    border-left: 4px solid var(--color-primary);
    
    h3 {
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-semibold);
      margin-bottom: var(--space-sm);
      color: var(--color-primary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    
    p {
      margin: 0;
      color: var(--color-text-light);
    }
  }
  
  .meta-grid {
    display: grid;
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
    
    @include media-md {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }
  
  .meta-section {
    h4 {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      margin-bottom: var(--space-sm);
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  }
  
  .case-study-content {
    margin-top: var(--space-2xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
    
    :global(h2) {
      margin-top: var(--space-2xl);
      padding-top: var(--space-lg);
    }
    
    :global(h3) {
      margin-top: var(--space-xl);
    }
  }
</style>
