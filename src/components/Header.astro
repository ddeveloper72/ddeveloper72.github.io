---
// Header component with navigation
interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Timeline', href: '/timeline' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' }
];

const isCurrentPage = (href: string) => currentPath === href;
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="site-logo">
        <span class="site-name">Duncan Falconer</span>
        <span class="site-tagline">Technical Architecture & Healthcare Interoperability</span>
      </a>
      
      <button 
        class="nav-toggle" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        type="button"
      >
        <span class="nav-toggle-icon"></span>
      </button>
      
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class="nav-item">
            <a 
              href={item.href} 
              class:list={['nav-link', { 'active': isCurrentPage(item.href) }]}
              aria-current={isCurrentPage(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @import '../styles/variables';
  
  .site-header {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) 0;
    position: sticky;
    top: 0;
    z-index: 50;
    
    @include media-md {
      padding: var(--space-lg) 0;
    }
  }
  
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  
  .site-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    
    &:hover {
      text-decoration: none;
      
      .site-name {
        color: var(--color-primary);
      }
    }
    
    &:focus-visible {
      @include focus-ring;
    }
  }
  
  .site-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    transition: color var(--transition-fast);
  }
  
  .site-tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    
    @include media-md {
      font-size: var(--font-size-base);
    }
  }
  
  // Mobile menu toggle
  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    
    @include media-md {
      display: none;
    }
    
    &:hover {
      background-color: var(--color-background-alt);
    }
    
    &:focus-visible {
      @include focus-ring;
    }
  }
  
  .nav-toggle-icon {
    width: 1.25rem;
    height: 2px;
    background-color: var(--color-text);
    position: relative;
    transition: background-color var(--transition-fast);
    
    &::before,
    &::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 2px;
      background-color: var(--color-text);
      transition: transform var(--transition-base);
    }
    
    &::before {
      top: -0.5rem;
    }
    
    &::after {
      bottom: -0.5rem;
    }
  }
  
  // Navigation list
  .nav-list {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    flex-direction: column;
    gap: var(--space-xs);
    
    @include media-md {
      display: flex;
      flex-direction: row;
      width: auto;
      gap: var(--space-sm);
    }
    
    @include media-lg {
      gap: var(--space-md);
    }
    
    &.open {
      display: flex;
    }
  }
  
  .nav-item {
    margin: 0;
  }
  
  .nav-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    border-radius: var(--border-radius-sm);
    transition: all var(--transition-fast);
    
    &:hover {
      color: var(--color-primary);
      background-color: var(--color-background-alt);
      text-decoration: none;
    }
    
    &:focus-visible {
      @include focus-ring;
    }
    
    &.active {
      color: var(--color-primary);
      background-color: var(--color-primary-light);
      background-color: rgba(0, 102, 204, 0.1);
    }
  }
</style>

<script>
  // Mobile menu toggle functionality
  const navToggle = document.querySelector('.nav-toggle');
  const navList = document.querySelector('.nav-list');
  
  if (navToggle && navList) {
    navToggle.addEventListener('click', () => {
      const isOpen = navList.classList.contains('open');
      navList.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
